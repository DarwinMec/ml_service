# Base de datos PostgreSQL usada por Spring Boot
ML_DB_URL=postgresql+psycopg2://postgres:admin1234@tp1-db-postgres.cx84ysq4aguc.us-east-2.rds.amazonaws.com:5432/db_tp1

# Backend Spring Boot
BACKEND_API_URL=http://localhost:8080/api

# Rutas internas del servicio ML
ML_ARTIFACTS_DIR=artifacts
ML_MODELS_DIR=artifacts/models
ML_METRICS_DIR=artifacts/metrics
ML_LOGS_DIR=artifacts/logs

# Configuración general
APP_NAME=GestRest AI ML Service
APP_VERSION=1.0.0
ENVIRONMENT=development

# Configuración de entrenamiento
RANDOM_SEED=42
MIN_ACTIVE_RATIO=0.20
MIN_TRAIN_WEEKS=24
VALIDATION_WEEKS=6
TEST_WEEKS=6

# Features
LAGS=1,2,3,4,8,12,26,52
ROLLING_WINDOWS=4,8,12

ML_STORAGE_BACKEND=s3
ML_S3_BUCKET=gestrest-ml-artifacts-870661253650
ML_S3_MODELS_PREFIX=models
ML_S3_METRICS_PREFIX=metrics
AWS_REGION=us-east-2

ML_TRAIN_MODE=sync
ML_MAX_ASYNC_TRAINING_JOBS=1