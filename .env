# Base de datos PostgreSQL usada por Spring Boot
ML_DB_URL=postgresql+psycopg2://postgres:1234@localhost:5432/db_TP1test2

# Backend Spring Boot
BACKEND_API_URL=http://localhost:8080/api

# Rutas internas del servicio ML
ML_ARTIFACTS_DIR=artifacts
ML_MODELS_DIR=artifacts/models
ML_METRICS_DIR=artifacts/metrics
ML_LOGS_DIR=artifacts/logs

# Configuración general
APP_NAME=GestRest AI ML Service
APP_VERSION=1.0.0
ENVIRONMENT=development

# Configuración de entrenamiento
RANDOM_SEED=42
MIN_ACTIVE_RATIO=0.20
MIN_TRAIN_WEEKS=24
VALIDATION_WEEKS=6
TEST_WEEKS=6

# Features
LAGS=1,2,3,4,8,12,26,52
ROLLING_WINDOWS=4,8,12